<Project>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Management" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup Condition="'$(RequiresDocsvisionSdk)' == 'true'">
    <Reference Include="$(DocsvisionSdkPath)\DocsVision*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(RequiresWebSdk)' == 'true'">
    <Reference Include="$(DocsvisionSdkPath)\System.Web.Mvc.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(DocsvisionSdkPath)\Autofac*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateDocsvisionSdk" BeforeTargets="ResolveAssemblyReferences" Condition="'$(RequiresDocsvisionSdk)' == 'true'">
    <Error Condition="!Exists('$(DocsvisionSdkPath)\DocsVision.Platform.ObjectManager.dll')"
           Text="Укажите /p:DocsvisionSdkPath=путь-к-локальным-сборкам-Docsvision-5.5. SDK и закрытые ключи в репозитории не хранятся." />
  </Target>
</Project>
